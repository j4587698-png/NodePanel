@using NodePanel.ControlPlane.Configuration
@using NodePanel.ControlPlane.Protocol
@using NodePanel.Core.Runtime
@model NodeEditorViewModel
@{
    ViewData["Title"] = "节点详情";
    var autoRefreshSeconds = Math.Clamp(Model.Form.TelemetryFlushIntervalSeconds, 5, 60);
    var autoRefreshMilliseconds = autoRefreshSeconds * 1000;
}


<style>
    .details-stack {
        display: grid;
        gap: 24px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
    }

    .runtime-grid {
        display: grid;
        gap: 16px;
    }

    .runtime-grid--summary {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    .runtime-panel {
        display: grid;
        gap: 12px;
        padding: 18px;
        border: 1px solid var(--admin-border);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.02);
    }

    .runtime-panel h4 {
        margin: 0;
    }

    .runtime-panel__subtitle {
        margin: 0;
    }

    .runtime-list {
        display: grid;
        gap: 12px;
    }

    .runtime-item {
        display: grid;
        gap: 10px;
        padding: 14px 16px;
        border: 1px solid var(--admin-border);
        border-radius: 14px;
        background: rgba(11, 13, 23, 0.35);
    }

    .runtime-item__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .runtime-item__title {
        display: grid;
        gap: 4px;
    }

    .runtime-item__title strong {
        font-size: 15px;
    }

    .runtime-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .runtime-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        border: 1px solid var(--admin-border);
        font-size: 12px;
        line-height: 1.4;
        background: rgba(255, 255, 255, 0.04);
    }

    .runtime-badge--ok {
        border-color: rgba(75, 179, 125, 0.55);
        color: #8fe2ad;
        background: rgba(75, 179, 125, 0.12);
    }

    .runtime-badge--warn {
        border-color: rgba(224, 171, 75, 0.55);
        color: #f0cf86;
        background: rgba(224, 171, 75, 0.12);
    }

    .runtime-badge--error {
        border-color: rgba(224, 90, 90, 0.55);
        color: #ff9d9d;
        background: rgba(224, 90, 90, 0.12);
    }

    .runtime-meta {
        display: grid;
        gap: 8px;
    }

    .runtime-meta__row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 14px;
    }

    .runtime-meta__row span {
        color: var(--admin-muted);
    }

    .runtime-meta__row strong {
        color: var(--admin-fg);
        font-weight: 600;
    }

    @@media (max-width: 980px) {
        .runtime-item__header {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<section class="page-header">
    <div>
        <p class="eyebrow">Node Details</p>
        <h2>@(string.IsNullOrWhiteSpace(Model.Form.DisplayName) ? Model.Form.NodeId : Model.Form.DisplayName)</h2>
        <p class="muted">节点运行态与遥测数据已经从编辑页拆出。当前节点按 `@Model.Form.TelemetryFlushIntervalSeconds` 秒上报一次，本页每 `@autoRefreshSeconds` 秒自动刷新。</p>
    </div>
    <div class="page-actions">
        @if (!Model.Runtime.Connected)
        {
            <form asp-action="DeleteNode" asp-route-nodeId="@Model.Form.NodeId" method="post" class="inline-form" onsubmit="return confirm('确定要删除这个离线节点吗？');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value='@Url.Action("Nodes", "Dashboard")' />
                <button type="submit" class="button button--danger">删除节点</button>
            </form>
        }
        <a class="button" asp-action="Nodes">返回节点列表</a>
        <a class="button button--primary" asp-action="NodeEdit" asp-route-nodeId="@Model.Form.NodeId">编辑节点</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice">@Model.StatusMessage</div>
}

<div id="node-details-runtime-root" class="details-stack">
    @await Html.PartialAsync("_NodeDetailsRuntime", Model)
</div>

@section Scripts {
    <script>
        (() => {
            const delay = @autoRefreshMilliseconds;
            const rootSelector = '#node-details-runtime-root';
            const requestUrl = '@(Url.Action("Node", "Dashboard", new { nodeId = Model.Form.NodeId }) ?? string.Empty)';
            const root = document.querySelector(rootSelector);
            let isRefreshing = false;

            if (!root || !requestUrl) {
                return;
            }

            const refreshRuntime = async () => {
                if (isRefreshing || document.visibilityState === 'hidden') {
                    return;
                }

                isRefreshing = true;

                try {
                    const url = new URL(requestUrl, window.location.origin);
                    url.searchParams.set('partial', '1');
                    url.searchParams.set('_refresh', Date.now().toString());

                    const response = await fetch(url.toString(), {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        cache: 'no-store',
                        credentials: 'same-origin'
                    });

                    if (response.redirected) {
                        window.location.href = response.url;
                        return;
                    }

                    if (!response.ok) {
                        return;
                    }

                    const html = await response.text();
                    const parser = new DOMParser();
                    const nextDocument = parser.parseFromString(html, 'text/html');
                    const nextRoot = nextDocument.querySelector(rootSelector);

                    // The controller returns a partial for partial=1; fall back to
                    // extracting the runtime root if a full page was returned.
                    root.innerHTML = nextRoot ? nextRoot.innerHTML : html;
                }
                catch (error) {
                    console.debug('Node runtime refresh skipped.', error);
                }
                finally {
                    isRefreshing = false;
                }
            };

            window.setInterval(refreshRuntime, delay);
        })();
    </script>
}
