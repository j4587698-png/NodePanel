@using NodePanel.Panel.Models
@model DashboardPageViewModel
@{
    ViewData["Title"] = "用户管理";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Users</p>
        <h2>用户管理</h2>
        <p class="muted">管理用户的订阅信息、流量用量和套餐分配。</p>
    </div>
    <div class="page-actions">
        <a class="button button--primary" asp-action="NewUser">新建用户</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice">@Model.StatusMessage</div>
}

<section class="card">
    <div class="card__header">
        <div>
            <p class="eyebrow">Users</p>
            <h3>所有用户</h3>
            <p class="muted">在线 IP 按节点当前会话去重；速度为各节点采样周期内的原始上下行平均值，不计流量倍率。“部分数据”表示部分节点或来源 IP 不可用。</p>
        </div>
        <span class="metric">@Model.TotalCount</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>用户</th>
                    <th>状态</th>
                    <th>限速</th>
                    <th>设备限制</th>
                    <th>在线 IP</th>
                    <th>当前速度</th>
                    <th>套餐</th>
                    <th>流量用量</th>
                    <th>节点范围</th>
                    <th>订阅令牌</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model.State.Users)
            {
                var summary = Model.State.TrafficSummaries.GetValueOrDefault(user.UserId);
                var usedBytes = Math.Max(0L, summary?.TotalBytes ?? 0L);
                var totalBytes = Math.Max(0L, user.Subscription.TransferEnableBytes);
                var cycleText = string.IsNullOrWhiteSpace(user.Subscription.Cycle)
                    ? string.Empty
                    : $"{PlanPresentation.GetCycleDisplayName(user.Subscription.Cycle)} · {PlanPresentation.GetCycleSummaryText(user.Subscription.Cycle)}";

                <tr>
                    <td>
                        <strong>@user.DisplayName</strong>
                        <div class="muted mono">@user.UserId</div>
                        @if (!string.IsNullOrWhiteSpace(user.Email))
                        {
                            <div class="muted">@user.Email</div>
                        }
                    </td>
                    <td>
                        <span class="badge @(user.Enabled ? "badge--ok" : "badge--idle")">
                            @(user.Enabled ? "启用" : "禁用")
                        </span>
                    </td>
                    <td>@PlanPresentation.FormatRate(user.BytesPerSecond)</td>
                    <td>@(user.DeviceLimit > 0 ? user.DeviceLimit.ToString() : "不限")</td>
                    <td data-activity-user="@user.UserId" data-activity-field="ips">—</td>
                    <td data-activity-user="@user.UserId" data-activity-field="speed">—</td>
                    <td>
                        <div>@(string.IsNullOrWhiteSpace(user.Subscription.PlanName) ? "-" : user.Subscription.PlanName)</div>
                        @if (!string.IsNullOrWhiteSpace(cycleText))
                        {
                            <div class="muted">@cycleText</div>
                        }
                        <div class="muted">到期：@(user.Subscription.ExpiresAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "长期有效")</div>
                    </td>
                    <td>
                        <div>@PlanPresentation.FormatTraffic(usedBytes)@(totalBytes > 0 ? $" / {PlanPresentation.FormatTraffic(totalBytes)}" : string.Empty)</div>
                        @if (totalBytes > 0 && usedBytes >= totalBytes)
                        {
                            <div class="inline-alert inline-alert--error" style="margin-top:4px;">流量耗尽</div>
                        }
                    </td>
                    <td>@(user.NodeIds.Count == 0 ? "全部节点" : string.Join(", ", user.NodeIds))</td>
                    <td class="mono">@user.SubscriptionToken</td>
                    <td class="table-actions">
                        <a class="button button--small" asp-action="UserEditor" asp-route-userId="@user.UserId">编辑</a>
                        <a class="button button--small" asp-controller="Portal" asp-action="Index" asp-route-token="@user.SubscriptionToken" target="_blank" rel="noreferrer">门户</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="pager">
            @if (Model.HasPreviousPage)
            {
                <a class="button button--small" asp-action="Users" asp-route-page="@(Model.Page - 1)">上一页</a>
            }
            <span class="muted">第 @Model.Page / @Model.TotalPages 页 · 共 @Model.TotalCount 条</span>
            @if (Model.HasNextPage)
            {
                <a class="button button--small" asp-action="Users" asp-route-page="@(Model.Page + 1)">下一页</a>
            }
        </nav>
    }
</section>

@section Scripts {
    <script>
        (() => {
            const requestUrl = '@Url.Action("UserActivity", "Dashboard", new { page = Model.Page })';
            const cells = [...document.querySelectorAll('[data-activity-user]')];
            const formatRate = value => {
                if (value === null || value === undefined) return '—';
                const units = ['B/s', 'KB/s', 'MB/s', 'GB/s', 'TB/s'];
                let unit = 0;
                while (value >= 1024 && unit < units.length - 1) {
                    value /= 1024;
                    unit++;
                }
                return `${value.toFixed(unit === 0 ? 0 : 2)} ${units[unit]}`;
            };
            let refreshing = false;
            const refresh = async () => {
                if (refreshing || document.visibilityState === 'hidden') return;
                refreshing = true;
                try {
                    const response = await fetch(requestUrl, { credentials: 'same-origin', cache: 'no-store' });
                    if (response.redirected) {
                        window.location.href = response.url;
                        return;
                    }
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    const data = await response.json();
                    const byUser = new Map(data.map(item => [item.userId, item]));
                    for (const cell of cells) {
                        const activity = byUser.get(cell.dataset.activityUser);
                        if (!activity || !activity.hasData) {
                            cell.textContent = '暂无数据';
                        } else {
                            const suffix = activity.isPartial ? '（部分数据）' : '';
                            cell.textContent = cell.dataset.activityField === 'ips'
                                ? `${activity.onlineIpCount}${suffix}`
                                : `↑ ${formatRate(activity.uploadBytesPerSecond)} / ↓ ${formatRate(activity.downloadBytesPerSecond)}${suffix}`;
                        }
                    }
                } catch (error) {
                    for (const cell of cells) cell.textContent = '获取失败';
                    console.error('User activity refresh failed.', error);
                } finally {
                    refreshing = false;
                }
            };
            refresh();
            window.setInterval(refresh, 5000);
        })();
    </script>
}
